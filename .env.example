# CareerPilot AI - example configuration. Copy to services/api/.env (local runs) or provide via your secret
# manager in deployed environments. NEVER commit real values.

# --- application ---
ENVIRONMENT=development                 # development | test | staging | production
SECRET_KEY=replace-with-64-random-chars # python -c "import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false                     # must be true in staging/production (HTTPS)
LOG_LEVEL=INFO

# --- database / cache ---
# Use 127.0.0.1 rather than localhost on Windows to avoid IPv6 resolution delays.
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@127.0.0.1:5432/careerpilot
REDIS_URL=redis://127.0.0.1:6379/0
TASK_MODE=inline                        # inline (dev/test) | celery (requires REDIS_URL and a worker)

# --- email ---
EMAIL_PROVIDER=console                  # console (dev only: logs emails) | smtp
EMAIL_FROM=CareerPilot AI <no-reply@example.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025                          # Mailpit in docker-compose
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- object storage ---
STORAGE_PROVIDER=local                  # local (dev only) | s3 (AWS S3 or MinIO)
LOCAL_STORAGE_PATH=./.data/storage
S3_ENDPOINT_URL=http://127.0.0.1:9000   # omit for AWS S3
S3_BUCKET=careerpilot-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10

# --- document processing ---
OCR_PROVIDER=none                       # none | tesseract (install the `ocr` extra and the tesseract binary)
MALWARE_SCANNER=none                    # none | clamav (fails closed when configured)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- AI ---
LLM_PROVIDER=mock                       # mock (deterministic, dev/test only) | anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                       # low | medium | high | xhigh | max
LLM_FALLBACKS=default                   # default (server-side refusal fallback) | off
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
LLM_INPUT_COST_PER_MTOK=4.0             # used only for cost estimates in ai_usage_records
LLM_OUTPUT_COST_PER_MTOK=20.0
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=hashing              # hashing (local lexical baseline) | openai_compatible
EMBEDDING_MODEL=hashing-v1
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_BASE=                     # e.g. https://api.voyageai.com/v1 for openai_compatible
EMBEDDING_API_KEY=

# --- product policy ---
REQUIRE_VERIFIED_COMPANY_TO_PUBLISH=true
JOB_MODERATION_ENABLED=false
AUTO_VERIFY_COMPANY_DOMAIN_MATCH=false

# --- web (apps/web, build time) ---
API_INTERNAL_URL=http://127.0.0.1:8000
